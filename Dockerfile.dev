FROM python:3.12-slim

WORKDIR /app

# Install system deps for asyncpg and Playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps (non-editable, just dependencies)
COPY pyproject.toml .
RUN pip install --no-cache-dir ".[dev,explorer,mcp]" || true
# Reinstall as editable once full source is available
COPY . .
RUN pip install --no-cache-dir -e ".[dev,explorer,mcp]"

# Install Playwright browser + system deps
RUN playwright install --with-deps chromium

CMD ["uvicorn", "backend.app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]
